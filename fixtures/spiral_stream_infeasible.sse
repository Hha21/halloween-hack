data: {"entry": {"lap": 2, "stage": "convergence", "message": "Infeasible design on lap 2: The spiral closes at MTOW 3,320 kg, above the 2,722 kg limit for a single-engine piston aircraft (FAA AC 23.1309-1E, Class I (single reciprocating engine, under 6,000 lb)). The statistical methods don't apply that far out.", "citations": ["Raymer 2ed, Ch. 3 (p. 22)", "Raymer 2ed, Eq. 3.11 (p. 23)", "Raymer 2ed, Eq. 3.4 (p. 12)", "Raymer 2ed, Eq. 3.8 (p. 17)", "Raymer 2ed, Eq. 5.6 (p. 85)", "Raymer 2ed, Eqs. 3.6 & 3.10 (pp. 17-18)", "Raymer 2ed, Table 3.1 (p. 13)", "Raymer 2ed, Table 3.2 (p. 16)", "Raymer 2ed, Table 3.4 (p. 19)", "Raymer 2ed, Table 5.2 (p. 79)", "Schrenk (1940) NACA TM 948 (Spanwise Lift Distribution)", "knowledge/equations.yaml#schrenk_lift_distribution", "Megson, Aircraft Structures for Engineering Students, Ch. 9 (I-Beam Sizing)", "knowledge/equations.yaml#ibeam_cap_sizing", "MIL-HDBK-5J / MMPDS-01, Table 3.2.3.0(b)", "knowledge/tables/materials.yaml#al_2024_t3", "Raymer 6ed, Table 6.3 (Fuselage Length Regression)", "Raymer 6ed, Table 6.4 (Tail Volume Coefficients C_HT=0.70, C_VT=0.04)", "knowledge/tables/aircraft_typical.yaml#ga_single_engine"], "level": "error", "timestamp": "2026-10-31T13:41:43+00:00"}}

